{
  "name": "vacation-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "node server.js",
    "build": "tsc -b && vite build",
    "build:server": "tsc server/index.ts --outDir dist/server",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "engines": {
    "node": "26.4.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@tabler/icons-react": "3.48.0",
    "@tailwindcss/postcss": "4.3.3",
    "@vercel/node": "3.3.4",
    "cors": "2.8.6",
    "date-fns": "4.4.0",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "groq-sdk": "1.6.0",
    "openai": "7.23.0",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "concurrently": "10.0.5",
    "oxlint": "1.81.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vite": "8.3.0"
  }
}
